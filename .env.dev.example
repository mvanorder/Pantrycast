POSTGRES_USER=pantrycast
POSTGRES_DB=pantrycast
POSTGRES_PASSWORD=devpassword

# Outgoing email. Unset SMTP_HOST -> the backend logs emails instead of
# sending them (uac-design.md §1). To use the optional Mailpit dev service
# (see docker-compose.dev.yml), uncomment:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_SECURITY=plaintext
EMAIL_BASE_URL=http://localhost:8080
