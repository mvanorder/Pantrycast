# Points the local venv backend at the dev db container's published port
# (docker compose -f docker-compose.yml -f docker-compose.dev.yml up).
# Values match .env.dev.example at the repo root.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pantrycast
POSTGRES_DB=pantrycast
POSTGRES_PASSWORD=devpassword

# Outgoing email (uac-design.md §1). With SMTP_HOST unset the app uses a
# console sender that logs each message instead of sending it — no setup
# needed for local dev/tests. To send for real (e.g. against a local Mailpit),
# uncomment and adjust:
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_SECURITY=plaintext          # starttls (default) | tls | plaintext
#   SMTP_USER=
#   SMTP_PASSWORD=                   # or SMTP_PASSWORD_FILE=/path/to/secret
#   EMAIL_FROM=Shopping Analysis <no-reply@localhost>
#   EMAIL_BACKEND=auto               # auto (default) | smtp | console
#   VERIFICATION_TOKEN_TTL_HOURS=24
# Public web origin the verification/reset links point at (a frontend page):
EMAIL_BASE_URL=http://localhost:8080
