POSTGRES_USER=pantrycast
POSTGRES_DB=pantrycast
# Password is not set here — see secrets/postgres_password_prod.txt.example

# Outgoing email (uac-design.md §1). EMAIL_BACKEND=smtp makes the app refuse to
# start unless SMTP_HOST is set and the config is internally coherent — so an
# omitted/half config is caught at boot instead of silently dropping
# verification / password-reset mail (a *wrong* host still only fails at send
# time — reachability can't be checked at boot). The SMTP password is a Docker
# secret (secrets/smtp_password_prod.txt.example), mounted by the overlay as
# SMTP_PASSWORD_FILE — don't put it here. SMTP_USER is required to pair with it
# (set both, or neither for an unauthenticated relay and drop SMTP_PASSWORD_FILE
# from the overlay).
EMAIL_BACKEND=smtp
SMTP_HOST=<your-provider-smtp-host>
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=<your-provider-smtp-username>
EMAIL_FROM=Shopping Analysis <no-reply@shopping.example.com>
EMAIL_BASE_URL=https://shopping.example.com
#
# The proxy image also needs EXPO_PUBLIC_API_URL (the public base URL prod is
# reached at) at *build* time. Compose reads build args from the shell env /
# root .env, not this file, so export it before `docker compose build`:
#   export EXPO_PUBLIC_API_URL=https://pantrycast.example.com
