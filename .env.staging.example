POSTGRES_USER=pantrycast
POSTGRES_DB=pantrycast
# Password is not set here — see secrets/postgres_password_staging.txt.example
#
# The proxy image also needs EXPO_PUBLIC_API_URL (the public base URL staging
# is reached at) at *build* time. Compose reads build args from the shell env
# / root .env, not this file, so export it before `docker compose build`:
#   export EXPO_PUBLIC_API_URL=https://staging.pantrycast.example.com
